PORT=8000
HOST=0.0.0.0

# Selecciona el proveedor activo: 'openrouter' o 'ollama'
AI_PROVIDER=openrouter

# Configuración OpenRouter (Nube)
OPENROUTER_API_KEY=tu_api_key_de_openrouter
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# Configuración Ollama (Local)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2-vision

# Integración Backend
API_GASTOS_URL=http://127.0.0.1:3000/api